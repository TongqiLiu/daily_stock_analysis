//@version=6
indicator("EMA200 MTF Setup v3", overlay=true, shorttitle="E200v3")

// ====== Inputs ======
htf = input.timeframe("240", "HTF for swing bias")
test_window = input.int(8, "Candidate window after touch", minval=2, maxval=30)
entry_window = input.int(24, "Formal entry window after touch", minval=6, maxval=80)
confirm_pct_input = input.float(0.1, "Confirmation buffer %", minval=0.0, step=0.05)
confirm_pct = confirm_pct_input / 100.0

pivot_left = input.int(2, "Pivot left bars", minval=1, maxval=10)
pivot_right = input.int(2, "Pivot right bars", minval=1, maxval=10)
near_ema_pct_input = input.float(0.5, "Pivot low near EMA200 %", minval=0.05, step=0.05)
near_ema_pct = near_ema_pct_input / 100.0
double_bottom_tol_input = input.float(0.25, "Double-bottom tolerance %", minval=0.05, step=0.05)
double_bottom_tol = double_bottom_tol_input / 100.0
stable_bars = input.int(2, "Stabilization closes", minval=1, maxval=8)
resistance_lookback = input.int(50, "Resistance lookback bars", minval=10, maxval=200)
min_rr = input.float(1.0, "Minimum R to recent resistance", minval=0.5, step=0.25)
stop_buffer_input = input.float(0.05, "Stop break buffer %", minval=0.0, step=0.05)
stop_buffer = stop_buffer_input / 100.0

show_panel = input.bool(true, "Show status panel (top-right)")
show_rules = input.bool(true, "Show rules box (bottom-left)")
show_bg = input.bool(true, "Color background by HTF bias")
show_structure = input.bool(true, "Show structure stop / resistance")

// ====== EMAs ======
ema200 = ta.ema(close, 200)
ema200_htf = request.security(syminfo.tickerid, htf, ta.ema(close, 200), lookahead=barmerge.lookahead_off)

// ====== Bias ======
swing_long = close > ema200_htf
swing_short = close < ema200_htf

// ====== Touch detection ======
touch = low <= ema200 and high >= ema200

// ====== Setup state ======
// state: idle(0) -> testing(1). Candidate is not a final reset; formal entry is.
var int state = 0
var int touch_bar = -1
var bool candidate_seen = false
var bool entry_seen = false

var float first_low = na
var int first_low_bar = na
var float second_low = na
var int second_low_bar = na
var bool hl_ready = false
var bool db_ready = false
var float active_stop = na
var string structure_text = "None"

new_touch = state == 0 and touch and swing_long
if new_touch
    state := 1
    touch_bar := bar_index
    candidate_seen := false
    entry_seen := false
    first_low := na
    first_low_bar := na
    second_low := na
    second_low_bar := na
    hl_ready := false
    db_ready := false
    active_stop := na
    structure_text := "Waiting"

bars_in_test = state == 1 ? bar_index - touch_bar : 0

// ====== Stage 1: original candidate reclaim ======
is_candidate = state == 1 and not candidate_seen and bars_in_test >= 1 and bars_in_test <= test_window and close > ema200 * (1 + confirm_pct)
if is_candidate
    candidate_seen := true

// ====== Stage 2: HL / double-bottom structure near EMA200 ======
pivot_low = ta.pivotlow(low, pivot_left, pivot_right)
pivot_bar = bar_index - pivot_right
pivot_ema = ema200[pivot_right]
pivot_near_ema = not na(pivot_low) and not na(pivot_ema) and math.abs(pivot_low - pivot_ema) / pivot_ema <= near_ema_pct
valid_pivot = state == 1 and not na(pivot_low) and pivot_bar >= touch_bar and pivot_bar <= touch_bar + entry_window and pivot_near_ema

if valid_pivot
    if na(first_low)
        first_low := pivot_low
        first_low_bar := pivot_bar
        structure_text := "First low"
    else if pivot_bar > first_low_bar
        // A second EMA-area pivot low can either be a higher low or a double bottom.
        diff_pct = (pivot_low - first_low) / first_low
        is_hl_pivot = pivot_low > first_low * (1 + double_bottom_tol)
        is_db_pivot = math.abs(diff_pct) <= double_bottom_tol

        if is_hl_pivot
            second_low := pivot_low
            second_low_bar := pivot_bar
            hl_ready := true
            db_ready := false
            active_stop := second_low
            structure_text := "Higher low"
        else if is_db_pivot
            second_low := pivot_low
            second_low_bar := pivot_bar
            hl_ready := false
            db_ready := true
            active_stop := math.min(first_low, second_low)
            structure_text := "Double bottom"
        else
            // A materially lower second low invalidates the previous base; restart structure tracking from this lower low.
            first_low := pivot_low
            first_low_bar := pivot_bar
            second_low := na
            second_low_bar := na
            hl_ready := false
            db_ready := false
            active_stop := na
            structure_text := "Lower low reset"

has_structure = hl_ready or db_ready
reclaimed_now = close > ema200 * (1 + confirm_pct)
stable_ratio = ta.lowest(close / ema200, stable_bars)
stable_near_ema = stable_ratio >= 1 - confirm_pct
recent_resistance = ta.highest(high[1], resistance_lookback)
risk_per_share = has_structure and not na(active_stop) ? close - active_stop : na
reward_to_resistance = not na(recent_resistance) ? recent_resistance - close : na
has_clear_risk = not na(risk_per_share) and risk_per_share > syminfo.mintick
has_1r_space = has_clear_risk and not na(reward_to_resistance) and reward_to_resistance >= risk_per_share * min_rr

is_formal_entry = state == 1 and candidate_seen and not entry_seen and has_structure and reclaimed_now and stable_near_ema and has_1r_space
if is_formal_entry
    entry_seen := true

pre_candidate_fail = state == 1 and not candidate_seen and bars_in_test >= 1 and bars_in_test <= test_window and close < ema200 * (1 - confirm_pct)
structure_fail = state == 1 and candidate_seen and not na(active_stop) and close < active_stop * (1 - stop_buffer)
post_candidate_fail = state == 1 and candidate_seen and na(active_stop) and close < ema200 * (1 - confirm_pct)
is_fail = pre_candidate_fail or structure_fail or post_candidate_fail
is_timeout = state == 1 and bars_in_test > entry_window

// ====== Track last signals ======
var float last_touch_price = na
var float last_candidate_price = na
var float last_entry_price = na
var float last_fail_price = na
var float last_entry_stop = na
var float last_entry_risk = na
var float last_entry_resistance = na

if new_touch
    last_touch_price := close
if is_candidate
    last_candidate_price := close
if is_formal_entry
    last_entry_price := close
    last_entry_stop := active_stop
    last_entry_risk := risk_per_share
    last_entry_resistance := recent_resistance
if is_fail
    last_fail_price := close

if is_formal_entry or is_fail or is_timeout
    state := 0
    touch_bar := -1
    candidate_seen := false
    entry_seen := false
    first_low := na
    first_low_bar := na
    second_low := na
    second_low_bar := na
    hl_ready := false
    db_ready := false
    active_stop := na
    structure_text := "None"

// ====== Plots ======
plot(ema200, color=color.new(color.blue, 0), linewidth=2, title="Chart EMA200")
plot(ema200_htf, color=color.new(color.red, 0), linewidth=3, title="HTF EMA200")

bgcolor(show_bg and swing_long ? color.new(color.green, 92) : show_bg and swing_short ? color.new(color.red, 94) : na, title="Bias bg")

plotshape(new_touch, title="觸碰", style=shape.labelup, location=location.belowbar, color=color.aqua, textcolor=color.black, text="觸碰", size=size.small)
plotshape(is_candidate, title="候選", style=shape.labelup, location=location.belowbar, color=color.lime, textcolor=color.black, text="候選", size=size.normal)
plotshape(is_formal_entry, title="正式入場", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, text="入場", size=size.large)
plotshape(valid_pivot and not has_structure, title="第一低點", style=shape.circle, location=location.belowbar, color=color.new(color.yellow, 0), size=size.tiny, offset=-pivot_right)
plotshape(valid_pivot and has_structure, title="HL/雙底", style=shape.diamond, location=location.belowbar, color=color.new(color.orange, 0), size=size.small, offset=-pivot_right)
plotshape(is_fail, title="失敗", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, text="失敗", size=size.normal)
plotshape(is_timeout, title="超時", style=shape.xcross, location=location.abovebar, color=color.gray, size=size.tiny)

plot(show_structure and state == 1 and not na(active_stop) ? active_stop : na, title="Structure stop", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)
plot(show_structure and state == 1 and not na(recent_resistance) ? recent_resistance : na, title="Recent resistance", color=color.new(color.purple, 15), linewidth=1, style=plot.style_linebr)

// ====== Status Panel ======
if show_panel and barstate.islast
    var table panel = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
    bias_text = swing_long ? "LONG (可做多)" : "SHORT (跳過)"
    bias_color = swing_long ? color.lime : color.red
    dist_pct = (close - ema200) / ema200 * 100
    dist_htf = (close - ema200_htf) / ema200_htf * 100
    state_text = state == 1 ? "測試中 (" + str.tostring(entry_window - bars_in_test) + " bars 內)" : "等待觸碰"
    stage_text = is_formal_entry ? "正式入場" : candidate_seen ? "候選中" : state == 1 ? "等待候選" : "Idle"
    rr_text = has_clear_risk ? str.tostring(reward_to_resistance / risk_per_share, "0.00") + "R" : "—"

    table.cell(panel, 0, 0, "EMA200 MTF Setup v3", text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(panel, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(panel, 0, 1, "HTF Bias", text_color=color.gray)
    table.cell(panel, 1, 1, bias_text, text_color=bias_color)
    table.cell(panel, 0, 2, "現價", text_color=color.gray)
    table.cell(panel, 1, 2, str.tostring(close, "#.##"), text_color=color.white)
    table.cell(panel, 0, 3, "Chart EMA200", text_color=color.gray)
    table.cell(panel, 1, 3, str.tostring(ema200, "#.##") + " (" + str.tostring(dist_pct, "+0.00") + "%)", text_color=color.white)
    table.cell(panel, 0, 4, "HTF EMA200", text_color=color.gray)
    table.cell(panel, 1, 4, str.tostring(ema200_htf, "#.##") + " (" + str.tostring(dist_htf, "+0.00") + "%)", text_color=color.white)
    table.cell(panel, 0, 5, "狀態", text_color=color.gray)
    table.cell(panel, 1, 5, state_text, text_color=color.yellow)
    table.cell(panel, 0, 6, "Stage", text_color=color.gray)
    table.cell(panel, 1, 6, stage_text, text_color=is_formal_entry ? color.lime : candidate_seen ? color.yellow : color.white)
    table.cell(panel, 0, 7, "結構", text_color=color.gray)
    table.cell(panel, 1, 7, structure_text, text_color=has_structure ? color.orange : color.white)
    table.cell(panel, 0, 8, "結構止損", text_color=color.orange)
    table.cell(panel, 1, 8, na(active_stop) ? "—" : "$" + str.tostring(active_stop, "#.##"), text_color=color.white)
    table.cell(panel, 0, 9, "最近阻力", text_color=color.purple)
    table.cell(panel, 1, 9, na(recent_resistance) ? "—" : "$" + str.tostring(recent_resistance, "#.##"), text_color=color.white)
    table.cell(panel, 0, 10, "R 空間", text_color=color.gray)
    table.cell(panel, 1, 10, rr_text, text_color=has_1r_space ? color.lime : color.red)
    table.cell(panel, 0, 11, "最後候選", text_color=color.lime)
    table.cell(panel, 1, 11, na(last_candidate_price) ? "—" : "$" + str.tostring(last_candidate_price, "#.##"), text_color=color.white)
    table.cell(panel, 0, 12, "最後入場", text_color=color.green)
    table.cell(panel, 1, 12, na(last_entry_price) ? "—" : "$" + str.tostring(last_entry_price, "#.##") + " / SL $" + str.tostring(last_entry_stop, "#.##"), text_color=color.white)

// ====== Rules box ======
if show_rules and barstate.islast
    var table rules = table.new(position.bottom_left, 1, 10, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)
    table.cell(rules, 0, 0, "操作規則", text_color=color.yellow, bgcolor=color.new(color.navy, 30))
    table.cell(rules, 0, 1, "1. 綠底 = HTF 多頭，可找多", text_color=color.white)
    table.cell(rules, 0, 2, "2. 觸碰 = 價格接近/碰到 Chart EMA200", text_color=color.aqua)
    table.cell(rules, 0, 3, "3. 候選 = " + str.tostring(test_window) + " 根內 reclaim EMA200", text_color=color.lime)
    table.cell(rules, 0, 4, "4. 第一低點/第二低點需靠近 EMA200", text_color=color.yellow)
    table.cell(rules, 0, 5, "5. 入場 = 候選 + HL/雙底 + 企穩 + >= " + str.tostring(min_rr, "0.00") + "R", text_color=color.green)
    table.cell(rules, 0, 6, "6. HL 止損參考第二低點", text_color=color.orange)
    table.cell(rules, 0, 7, "7. 雙底止損參考兩低點較低者", text_color=color.orange)
    table.cell(rules, 0, 8, "8. 跌破結構止損 = setup 失敗", text_color=color.red)
    table.cell(rules, 0, 9, "注意：Recent resistance 只是近 " + str.tostring(resistance_lookback) + " 根高點", text_color=color.gray)

// ====== Alerts ======
alertcondition(new_touch, title="觸碰 EMA200", message="{{ticker}} 觸碰 EMA200, 進入測試期")
alertcondition(is_candidate, title="候選 - EMA200 Reclaim", message="{{ticker}} reclaim EMA200 - Candidate at {{close}}")
alertcondition(is_formal_entry, title="正式入場 - HL/DB Setup Confirmed", message="{{ticker}} EMA200 HL/DB setup confirmed - Entry at {{close}}")
alertcondition(is_fail, title="失敗 - Setup Failed", message="{{ticker}} setup failed - Exit/skip at {{close}}")
